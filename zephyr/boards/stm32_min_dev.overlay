/ {
	model = "BlackPill F103C8";
	compatible = "st,stm32f103c8";

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};
		led1: led_1 {
			gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
	};
};

zephyr_udc0: &usb {
	status = "disabled";  /* 禁用USB功能以避免与PA11冲突 */
};
