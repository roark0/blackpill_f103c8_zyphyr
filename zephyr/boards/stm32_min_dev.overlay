/ {
	model = "BlackPill F103C8";
	compatible = "st,stm32f103c8";

	leds {
		compatible = "gpio-leds";
		led1: led_1 {
			gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;
		};
		led2: led_2 {
			gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		led1 = &led1;
		led2 = &led2;
	};
};

&usart1 {
	/* 配置为兼容旧程序的 19200 波特率 */
	current-speed = <19200>;
	/* 配置为 8 位数据 + 奇校验 */
	parity = "odd";
	status = "okay";
};

zephyr_udc0: &usb {
	status = "disabled";  /* 禁用USB功能以避免与PA11冲突 */
};

&pinctrl {
	swj-cfg = "jtag-disable";
};

