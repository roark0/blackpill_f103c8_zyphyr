/ {
	model = "BlackPill F103C8";
	compatible = "st,stm32f103c8";

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};
		led1: led_1 {
			gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
	};
};

&usart1 {
	/* 配置为兼容旧程序的 19200 波特率 */
	current-speed = <19200>;
	/* 配置为 8 位数据 + 奇校验 */
	parity = "odd";
	status = "okay";
};

zephyr_udc0: &usb {
	status = "disabled";  /* 禁用USB功能以避免与PA11冲突 */
};
